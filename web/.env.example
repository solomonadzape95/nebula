# Indexer database. The app reads vault history and writes profiles and reviews here.
#
# On Vercel use Supabase's *transaction pooler* URI (port 6543), not the direct connection: the
# direct host is IPv6-only and serverless functions open a connection per invocation, which
# exhausts a direct pool quickly.
DATABASE_URL=postgres://user@localhost:5432/nebula_indexer

# Soroban RPC. Defaults to the public testnet endpoint when unset.
RPC_URL=https://soroban-testnet.stellar.org

# Gate for the admin surface. Compared server-side; never sent to the browser.
ADMIN_PASSWORD=change_me

# Key used to sign the admin session cookie and the wallet-ownership session.
#
# Falls back to ADMIN_PASSWORD when unset, which works but ties session validity to the password.
# Set it to its own long random value in production: `openssl rand -base64 32`. Rotating it signs
# every live session out, which is what you want after a suspected leak.
ADMIN_SESSION_SECRET=

# PostHog project key — the public "phc_..." one from Project Settings, not a personal API key.
# Safe in the browser: it can only write events.
#
# Leave it empty in local development. Analytics then does nothing at all, rather than filling the
# production project with your own clicking.
NEXT_PUBLIC_POSTHOG_KEY=
