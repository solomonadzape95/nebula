# Copy to .env and fill in.

# Local Postgres from docker-compose (port 5433 to avoid clashing with a system Postgres).
DATABASE_URL=postgres://nebula:nebula@localhost:5433/nebula

# Which deployments/<network>.json to read contract addresses from.
NETWORK=testnet

# Defaults to the public Soroban RPC for the network. Override for a private endpoint.
# RPC_URL=https://soroban-testnet.stellar.org

# Ledger to start from on a fresh database. Defaults to the oldest ledger RPC still retains.
# START_LEDGER=

# Seconds between passes in `watch` mode.
POLL_SECONDS=15
